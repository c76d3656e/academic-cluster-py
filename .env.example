# =============================================================================
# Academic Cluster Python - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Primary LLM Provider（单 provider 时使用以下配置）
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_openai_api_key_here

# LLM 多 Provider Pool（JSON 数组，设置后优先于上面的单 provider 配置）
# 支持：同 URL 多 key 负载均衡 + 不同 URL 不同 provider 混合
# LLM_PROVIDERS_JSON=[{"name":"gitee","model":"internlm3-8b-instruct","api_url":"https://ai.gitee.com/v1","api_key":"key1","rpm_limit":10,"priority":1},{"name":"siliconflow","model":"THUDM/GLM-Z1-9B-0414","api_url":"https://api.siliconflow.cn/v1","api_key":"key2","rpm_limit":30,"priority":1}]

# -----------------------------------------------------------------------------
# Embedding Configuration (pgvector stores the dimension returned by each model)
# -----------------------------------------------------------------------------
# 单 Provider
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=your_embedding_api_key_here

# 多 Provider Pool（JSON 数组，设置后优先于单 provider）
# EMBEDDING_PROVIDERS_JSON=[{"name":"siliconflow","model":"BAAI/bge-m3","api_url":"https://api.siliconflow.cn/v1","api_key":"key1","rpm_limit":10,"priority":1}]

# -----------------------------------------------------------------------------
# Agent admission and external-service backpressure
# -----------------------------------------------------------------------------
# These are in-flight/queue capacities, independent from provider RPM/TPM.
# The current PostgreSQL checkpoint owner is single-instance; tune them from
# measured provider, database, and CPU capacity before raising the defaults.
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_MAX_QUEUED_RUNS=32
AGENT_MAX_ADMITTED_RUNS_PER_USER=2
AGENT_MAX_PER_RUN_LLM_REQUESTS=4
AGENT_QUEUE_WAIT_TIMEOUT_SECONDS=900
AGENT_CANCEL_TIMEOUT_SECONDS=30
LLM_MAX_CONCURRENT_REQUESTS=8
LLM_MAX_QUEUED_REQUESTS=64
LLM_QUEUE_WAIT_TIMEOUT_SECONDS=120
EMBEDDING_MAX_CONCURRENT_REQUESTS=4
EMBEDDING_MAX_QUEUED_REQUESTS=32
EMBEDDING_QUEUE_WAIT_TIMEOUT_SECONDS=120
SSE_MAX_QUEUE_EVENTS=128
SSE_MAX_CONNECTIONS_PER_PROJECT=20

# -----------------------------------------------------------------------------
# Academic Data Sources
# -----------------------------------------------------------------------------
# Semantic Scholar（多 key 逗号分隔，每个 key 独立 1 rps）
SEMANTIC_SCHOLAR_API_KEY=your_s2_key_1,your_s2_key_2

# PubMed
PUBMED_EMAIL=your_email@example.com
PUBMED_API_KEY=your_pubmed_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# PostgreSQL
POSTGRES_HOST=localhost
# 本地进程连接 Compose 暴露端口；容器内由 Compose 覆盖为 5432
POSTGRES_PORT=5433
POSTGRES_DB=academic_cluster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
APP_POSTGRES_USER=academic_app
APP_POSTGRES_PASSWORD=your_distinct_application_database_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
REDIS_DB=0

# -----------------------------------------------------------------------------
# Optional Langfuse node tracing
# -----------------------------------------------------------------------------
# Disabled by default. Node payloads are represented by schema/digest metadata unless
# LANGFUSE_CAPTURE_NODE_IO is explicitly enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=academic-cluster-0.1.0
LANGFUSE_SAMPLE_RATE=1.0
LANGFUSE_CAPTURE_NODE_IO=false

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
MAX_REQUEST_BODY_BYTES=1048576
MAX_PROJECT_CONFIG_BYTES=65536
REGISTRATION_ENABLED=false
AUTH_LOGIN_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT=3
AUTH_REFRESH_RATE_LIMIT=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_PROJECTS_PER_USER=20
# Only trust X-Forwarded-For from explicitly listed reverse proxy IPs.
TRUSTED_PROXY_IPS=
# Docker 暴露的后端宿主端口
APP_PORT=8000

# Logging
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Admin Account（首次启动时自动创建，修改后重启生效）
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@cluster.local
# !! 必须设置一个强密码，留空将跳过管理员创建（生产环境留空会启动失败） !!
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator

# JWT（生产环境必须修改）
JWT_SECRET_KEY=your_jwt_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=academic_cluster_refresh
AUTH_ALLOW_LEGACY_REFRESH_BODY=false

# Provider API Key 的持久化加密密钥；生产环境必须固定且至少 32 字符。
# 可生成 Fernet key：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_ENCRYPTION_KEY=your_provider_encryption_key_here

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
